{
  "name": "todo",
  "version": "0.1.0",
  "private": true,
  "description": "Secure serverless todo app: DynamoDB + Lambda + API Gateway/Cognito + React on S3/CloudFront, deployed with AWS CDK.",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22 <23"
  },
  "workspaces": [
    "infra",
    "backend",
    "frontend"
  ],
  "scripts": {
    "lint": "npm run lint --workspaces --if-present",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "pretest": "npm run build -w frontend",
    "test": "npm run test --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "presynth": "npm run build -w frontend",
    "synth": "npm run synth --workspace infra --"
  },
  "devDependencies": {
    "prettier": "3.9.10"
  }
}
